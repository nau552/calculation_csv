{
    // result_tmp_mini 用のスコア設計例。
    // 現行スクリプトとの数値比較用に、各集計を素直な形にしてある。
    // 実行コマンド:
    //   .venv/Scripts/python -m scorelib_param.cli --config config_mini.jsonc --data-dir result_tmp_mini \
    //       --dvtbudget-coef dvtbudget_coef.jsonc --initial-temperature result_tmp_mini/initial_temperature.csv
    "Generation": "B9LS",

    "optimization": {

        "score_function": "gui_score",

        "vthSkip": {
            "epochs": 100,
            "dummyKLDValue": 0,
            "dummyDVthValue": 1
        },

        "constraintThreshold": {
            "dVtBudget_A2B": {"value": 10, "active": "True", "type": "percentile", "coef": 20}
        },

        // result_tmp_mini の WL は 0~5 なので 2 グループに分割する例
        "WLgroupDefinLogical": "True",
        "WLgroup": {
            "WLgroup02": [0, 2],
            "WLgroup01": [3, 4],
            "WLgroup00": [5, 5]
        },

        // "WLgroupWeight": 2.0
        "WLgroupWeight": {
            "WLgroup02": 1.0,
            "WLgroup01": 1.0,
            "WLgroup00": 10.0
        },

        "score_parts": [
            // 1) FBC 相対値の全平均: 最も素直な形。
            //    Override=False(基準パラ) を分母、True(提案パラ) を分子とし、
            //    分母は WL,STR を先に平均してから比を取る。offset=1 を分子分母両方に加算。
            {
                "name": "FBC_upper1_A2B_rel",
                "type": "FBC",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 1,
                    "denominator_pre_aggregation": [
                        {"axis": "WL", "op": "mean"},
                        {"axis": "STR", "op": "mean"}
                    ]
                },
                "order": ["Read_Label", "State", "WL", "STR", "Board", "Chip", "Block"],
                "aggregations": {
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "State": {"op": "filter", "value": "A2B"},
                    "WL": {"op": "mean"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "mean"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            // 2) WLgroup 単位の worst を見る例。WLgroup は optimization.WLgroup 由来の
            //    派生軸で、order の好きな位置に置いて畳める（ここでは WL 平均の直後に max）
            {
                "name": "FBC_upper1_A2B_worstWLg",
                "type": "FBC",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 1
                },
                "order": ["Read_Label", "State", "WL", "WLgroup", "STR", "Board", "Chip", "Block"],
                "aggregations": {
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "State": {"op": "filter", "value": "A2B"},
                    "WL": {"op": "mean"},
                    "WLgroup": {"op": "max"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "mean"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            // 3) tR (FBC 以外の type の例): Page 軸は map_Page.csv により L/M/U に解決される。
            {
                "name": "tR_delta",
                "type": "tR",
                "relative": {
                    "split_axis": "Read_Override",
                    "mode": "diff",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0
                },
                "order": ["Read_Label", "Page", "WL", "STR", "Board", "Chip", "Block", "__relative__"],
                "aggregations": {
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "Page": {"op": "mean"},
                    "WL": {"op": "mean"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "mean"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            // 4) dVtBudget: FBC.csv を読み、自動で相対値化 -> -log10(rel)/b*1000 変換。
            //    b は Generation(B9LS) x Board別実測温度の最近傍キー x State で解決される。
            {
                "name": "dVtBudget_R2A",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 1
                },
                "order": ["Read_Label", "State", "WL", "STR", "Board", "Chip", "Block"],
                "aggregations": {
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "State": {"op": "filter", "value": "R2A"},
                    "WL": {"op": "mean"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "mean"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

           {
                "name": "dVtBudget_A2B",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 1
                },
                "order": ["Read_Label", "State", "WL", "STR", "Board", "Chip", "Block"],
                "aggregations": {
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "State": {"op": "filter", "value": "A2B"},
                    "WL": {"op": "mean"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "mean"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "deltaR_upper_tail",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "Read_Label",                     // filter（相対化前: 分子側/分母側それぞれに効く）
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "State", "Chip", "Block", "Board"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "WL": {"op": "mean"},
                    "State": {"op": "filter", "value": "R2A"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "deltaA_lower_tail",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "Read_Label",                     // filter（相対化前: 分子側/分母側それぞれに効く）
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "State", "Chip", "Block", "Board"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "Read_Label": {"op": "filter", "value": "read_level_lower1"},
                    "WL": {"op": "mean"},
                    "State": {"op": "filter", "value": "A2R"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "deltaA_upper_tail",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "Read_Label",                     // filter（相対化前: 分子側/分母側それぞれに効く）
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "State", "Chip", "Block", "Board"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "WL": {"op": "mean"},
                    "State": {"op": "filter", "value": "A2B"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "deltaB_lower_tail",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "Read_Label",                     // filter（相対化前: 分子側/分母側それぞれに効く）
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "State", "Chip", "Block", "Board"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "Read_Label": {"op": "filter", "value": "read_level_lower1"},
                    "WL": {"op": "mean"},
                    "State": {"op": "filter", "value": "B2A"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "dAR_margin",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "Chip", "Block", "Board", "State&Read_Label"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "State&Read_Label": {
                        "op": "diff",
                        "value": [
                            {"State": "R2A", "Read_Label": "read_level_upper1"},
                            {"State": "A2R", "Read_Label": "read_level_lower1"}
                        ]
                    },
                    "WL": {"op": "mean"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "dBR_margin",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "Chip", "Block", "Board", "State&Read_Label"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "State&Read_Label": {
                        "op": "expr",
                        "expr":"-1*by['A2B&read_level_upper1'] + by['B2A&read_level_lower1']"
                    },
                    "WL": {"op": "mean"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "dVtBudget_custom_flow3",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "Read_Label",                     // filter（相対化前: 分子側/分母側それぞれに効く）
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "State", "Chip", "Block", "Board"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "WL": {"op": "mean"},
                    "State": {"op": "filter", "value": "A2B"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "dVtBudget_custom_flow4",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "Read_Label",                     // filter（相対化前: 分子側/分母側それぞれに効く）
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "State", "Chip", "Block", "Board"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "WL": {"op": "mean"},
                    "State": {"op": "filter", "value": "A2B"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            },

            {
                "name": "dVtBudget_custom_flow5",
                "type": "dVtBudget",
                "relative": {
                    "split_axis": "Read_Override",
                    "numerator_when": true,
                    "denominator_when": false,
                    "denominator_offset": 0          // offsetは下の__offset__ステップで明示的に足すので0
                },
                "order": [
                    "Read_Label",                     // filter（相対化前: 分子側/分母側それぞれに効く）
                    "__offset__",                     // 全行のFBCに+1
                    "STR",
                    "WL",                             // WL平均（分子側・分母側それぞれで集計される）
                    "__relative__",                   // ここで比を取る
                    "__dvtbudget__",                  // ここで -log10(rel)/b*1000 変換
                    "State", "Chip", "Block", "Board"
                ],
                "aggregations": {
                    "__offset__": {"op": "add", "value": 1},
                    "Read_Label": {"op": "filter", "value": "read_level_upper1"},
                    "WL": {"op": "mean"},
                    "State": {"op": "filter", "value": "A2B"},
                    "STR": {"op": "mean"},
                    "Board": {"op": "max"},
                    "Chip": {"op": "mean"},
                    "Block": {"op": "mean"}
                }
            }
        ],

        // "expression": "FBC_upper1_A2B_rel + 0.5 * FBC_upper1_A2B_worstWLg + 0.1 * tR_upper1_U_rel"
        "expression": "tR_delta - (-1 *deltaR_upper_tail -1 * deltaA_lower_tail -1* deltaA_upper_tail -1* deltaB_lower_tail)"
    }
}
