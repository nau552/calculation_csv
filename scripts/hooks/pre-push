#!/bin/sh
# push 前に全テストを実行する保険（CLAUDE.md「変更完了の定義」の物理的な担保）。
# 有効化（リポジトリごとに1回）: git config core.hooksPath scripts/hooks
# 緊急時の回避: git push --no-verify（非推奨。CI が同じテストで落ちる）

if [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"       # Windows venv
elif [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"               # Unix venv
else
  echo "pre-push: .venv が見つからないためテストをスキップします（CI に委ねる）" >&2
  exit 0
fi

echo "pre-push: テスト実行中（失敗すると push は中止されます）..." >&2
"$PY" -m pytest -q >&2 || {
  echo "pre-push: テスト失敗のため push を中止しました" >&2
  exit 1
}
exit 0
